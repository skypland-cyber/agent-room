{
  "name": "agent-room",
  "private": true,
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-room-alkl/agent-room.git"
  },
  "homepage": "https://agent-room-henna.vercel.app",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "npm -ws run test --if-present",
    "test:api": "vitest run --dir api",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "build": "npm -ws run build --if-present",
    "build:ordered": "npm run build -w packages/shared && npm run build -w packages/upstash-client && npm run build -w packages/room-persistence && npm run build -w apps/web",
    "dev:web": "npm -w apps/web run dev"
  },
  "devDependencies": {
    "@vercel/node": "^5.7.13",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1040.0",
    "@aws-sdk/s3-request-presigner": "3.1040.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@notionhq/client": "^5.32.0",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.9.0"
  }
}
